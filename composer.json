{
    "name": "drevops/phpcs-standard",
    "description": "DrevOps PHP_CodeSniffer rules: enforce consistent naming (snakeCase or camelCase) for variables and parameters, PHPUnit data provider conventions.",
    "license": "GPL-2.0-or-later",
    "type": "phpcodesniffer-standard",
    "keywords": [
        "phpcs",
        "phpcodesniffer",
        "standards",
        "snakeCase",
        "camelCase",
        "naming-conventions",
        "code-quality",
        "phpunit",
        "data-providers"
    ],
    "authors": [
        {
            "name": "Alex Skrypnyk",
            "email": "alex@drevops.com",
            "homepage": "https://github.com/alexskrypnyk",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/drevops/phpcs-standard",
    "support": {
        "issues": "https://github.com/drevops/phpcs-standard/issues",
        "source": "https://github.com/drevops/phpcs-standard"
    },
    "require": {
        "php": ">=8.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1",
        "squizlabs/php_codesniffer": "^3.10 || ^4"
    },
    "require-dev": {
        "alexskrypnyk/phpunit-helpers": "^1.2.0",
        "drupal/coder": "^8.3.31 || ^9.0.1",
        "ergebnis/composer-normalize": "^2.54.0",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^12.5.37",
        "rector/rector": "^2.6.7"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "DrevOps\\": "src/DrevOps/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DrevOps\\PhpcsStandard\\Tests\\": "tests"
        },
        "classmap": [
            "tests"
        ],
        "exclude-from-classmap": [
            "tests/Fixtures/Drupal/"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        },
        "discard-changes": true,
        "sort-packages": true
    },
    "extra": {
        "phpcodesniffer-standard": [
            "DrevOps"
        ]
    },
    "scripts": {
        "lint": [
            "phpcs",
            "phpstan",
            "rector --dry-run"
        ],
        "lint-fix": [
            "rector",
            "phpcbf"
        ],
        "reset": "rm -Rf vendor composer.lock",
        "test": "phpunit --no-coverage",
        "test-coverage": "phpunit"
    }
}
